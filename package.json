{
  "name": "@cpilsworth/skills",
  "version": "0.1.0",
  "private": true,
  "description": "Skills for AI coding agents",
  "scripts": {
    "plugins:sync": "node scripts/sync-plugin-skills.mjs",
    "validate:skills": "find . -name SKILL.md -exec dirname {} \\; | xargs -I {} skills-ref validate {}",
    "validate:plugins": "node scripts/validate-plugins.mjs --check",
    "validate": "npm run validate:skills && npm run validate:plugins"
  },
  "devDependencies": {
    "skills-ref": "^0.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cpilsworth/skills.git"
  },
  "license": "Apache-2.0"
}
